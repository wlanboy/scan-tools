{
  "_docs": "Jeder Eintrag unterdrückt einen Fund, wenn ALLE angegebenen Felder übereinstimmen. 'file' und 'value' vergleichen exakt (value = gesamter Treffer inkl. Schlüsselname), 'file_pattern' und 'value_pattern' per Regex. 'comment' wird ignoriert. Details: scan-secrets.md",
  "entries": [

    {
      "value": "ghp_ExamplePersonalAccessToken00000000",
      "comment": "GitHub PAT des CI-Service-Accounts – wird monatlich rotiert"
    },

    {
      "file": "config/example.yml",
      "comment": "Beispiel-Konfigurationsdatei, enthält keine echten Credentials"
    },

    {
      "file_pattern": "docs/",
      "comment": "Alle Dateien unter docs/ sind Dokumentation, keine Live-Secrets"
    },

    {
      "category": "jwt_token",
      "file_pattern": "fixtures/|testdata/",
      "comment": "Test-JWTs in Fixture-Verzeichnissen sind immer synthetisch"
    },

    {
      "category": "password",
      "file_pattern": "(^|/)docker-compose\\.example\\.ya?ml$",
      "comment": "Demo-Passwörter in Docker-Compose-Beispielen"
    },

    {
      "value_pattern": "localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0",
      "comment": "Loopback-Adressen enthalten keine produktiven Secrets"
    },

    {
      "category": "basic_auth_url",
      "value_pattern": "user:password@|admin:admin@",
      "comment": "Generische Demo-Credentials in README-Beispielen"
    },

    {
      "category": "bearer_token",
      "file_pattern": "^k8s/overlays/dev/",
      "comment": "Entwicklungs-Tokens im Dev-Overlay sind nicht produktiv"
    },

    {
      "category": "artifactory_token",
      "value_pattern": "AKCp8example0{20,}",
      "comment": "Artifactory-Beispieltoken aus der offiziellen JFrog-Doku"
    },

    {
      "file_pattern": "\\.md$|\\.txt$|\\.rst$",
      "category": "oauth_secret",
      "comment": "OAuth-Secrets in Markdown/Text-Dateien sind Dokumentationsbeispiele"
    }

  ]
}
